# Copy to .env.local and fill in. Never commit real values.
# Without the Supabase pair the app runs in demo mode (local data, no accounts).

# Public (end up in the browser bundle: never put secrets here)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_BILLING_ENABLED=false

# Server only
DATABASE_URL=                      # Supabase > Project Settings > Database > connection string (pooler, transaction mode)
SUPABASE_SERVICE_ROLE_KEY=         # optional today; reserved for admin tasks
STRIPE_SECRET_KEY=                 # sk_test_... until /replica-deploy
STRIPE_WEBHOOK_SECRET=             # whsec_... from `stripe listen` locally, or the dashboard endpoint in production
STRIPE_PRICE_CREADOR_MONTHLY=
STRIPE_PRICE_CREADOR_YEARLY=
STRIPE_PRICE_ESTUDIO_MONTHLY=
STRIPE_PRICE_ESTUDIO_YEARLY=
JAMENDO_CLIENT_ID=                 # https://devportal.jamendo.com — read the API terms for commercial use first
CRON_SECRET=                       # 32+ random characters: openssl rand -hex 32
